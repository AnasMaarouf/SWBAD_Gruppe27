{
  "Serilog": {
    "JWT": {
      "Issuer": "AarhusSpaceProgram",
      "Audience": "AarhusSpaceProgram",
      "SigningKey": "AUSpaceProgSignature"
    },
    "Using": [ "Serilog.Sinks.MongoDB" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "MongoDB",
        "Args": {
          "databaseUrl": "mongodb://localhost:27017/AarhusSpaceLogs",
          "collectionName": "RequestLogs"
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "AarhusSpaceLogs",
    "CollectionName": "RequestLogs"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost;Initial Catalog={DbName};User ID=sa;Password=Abcd123456!;Connect Timeout=30;Encrypt=True;Trust Server Certificate=True;Authentication=SqlPassword;Application Intent=ReadWrite;"
  },
  "AllowedHosts": "*"
  
}
